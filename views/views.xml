        <!--- PATIENT TRACKING  -->
        <record id="medical_patient_tracking_list_view_list" model="ir.ui.view">
            <field name="name">medical.patient.tracking.list.list</field>
            <field name="model">medical.patient.tracking.list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date"/>
                    <field name="patient_id"/>
                    <field name="info"/>
                    <field name="create_uid"/>
                </list>
            </field>
        </record>

        <record id="medical_patient_tracking_list_view_form" model="ir.ui.view">
            <field name="name">medical.patient.tracking.list.form</field>
            <field name="model">medical.patient.tracking.list</field>
            <field name="arch" type="xml">
                <form string="Praćenje pacijenta">
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="patient_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="create_uid" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="info" placeholder="Informacije..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--- RES PARTNER form  -->
        <!--
            medical_partner_view_inherit — geriatrics res.partner (patient, institution, contract roles).

            inherit_id ref="base.view_partner_form" means this record only patches the standard partner
            form. It does not define a second, private form. View inheritance merges all extensions into
            one combined architecture for every screen that uses that base view (Contacts, embedded
            partner editors, and so on).

            Interaction with other modules
            ..................................
            Any module that also inherits base.view_partner_form (for example mail, account, sale,
            website) contributes xpaths to the same tree. Merge order is by view priority, then by
            view id. This record uses priority 50 so it usually runs after typical core inherits (for
            example mail on partner). Installing or upgrading another app later can change the merged
            XML so an xpath here matches no node (upgrade error: element cannot be located) or more
            than one node. After such changes, upgrade geriatrics_v2 and retest the partner form.

            is_geriatrics (computed on the model, not stored) is true when is_patient or is_institution,
            or when the partner is linked on a contract as patient contact, requestor, or contractor.
            It is recomputed when the record is read (e.g. opening the form). VAT, category_id (tags),
            street2, and state_id use invisible="is_geriatrics" (main address xpath and div_address fallback);
            when false, stock Odoo behaviour applies.

            Applied in this arch
            ..................................
            - Gerijatrija block: is_patient, is_institution (mutually exclusive in Python);
              it is added as a group with colspan="2", spans both columns of the left inner group so 
              toggles are not beside the address grid row; 
              inner col="4" keeps Pacijent/Institucija labels + boolean_toggle on one row.
            - Address: separator string="Adresa" colspan="2" before address_name; stock span address_name
              is invisible="1" (redundant with Adresa). Span kept in arch for following-sibling xpaths.
              o_address_format gets colspan="2" so fields span the row after the label cell is hidden.
            - Email / phone: readonly if is_patient; institution can edit them.
            - Website: readonly if is_patient only (institution can edit website).
            - company_type, parent_id (Company), company name row: invisible if is_patient, is_institution,
              is_contractor, or is_requestor (latter two come from saved medical.patient.contract links).
            - function: readonly for everyone.
            - Ugovori: group visible if is_geriatrics; patient vs signatory lists use flags / contract data.
            - Pages sales_purchases and contact_addresses: invisible if is_patient or is_institution.

            Hidden technical fields in sheet: is_geriatrics, is_contractor, is_requestor (for modifiers).
        -->
        <record id="medical_partner_view_inherit" model="ir.ui.view">
            <field name="name">Partner_patient.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority" eval="50"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <field name="is_geriatrics" invisible="1"/>
                    <field name="is_contractor" invisible="1"/>
                    <field name="is_requestor" invisible="1"/>
                </xpath>
                <xpath expr="//span[@name='address_name']" position="before">
                    <!-- in base.view_partner_form: 
                        <group>
                            ...
                            <span class="o_form_label" name="address_name"> <field name="type_address_label" ...../>
                            </span>
                            <div class="o_address_format">
                                <field name="street" .../>
                                <field name="street2" .../>
                                <field name="city" .../> 
                                ...
                            <div>
                        </group> 

                        outer group has colspan="2" by default    
                    --> 
                    <group string="Gerijatrija" colspan="2" col="4">
                        <label for="is_patient" string="Pacijent"/>
                        <field name="is_patient" nolabel="1" widget="boolean_toggle"/>
                        <label for="is_institution" string="Institucija"/>
                        <field name="is_institution" nolabel="1" widget="boolean_toggle"/>
                    </group>
                </xpath>
                <xpath expr="//span[@name='address_name']" position="before">
                    <separator string="Adresa" colspan="2"/>
                </xpath>
                <xpath expr="//span[@name='address_name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//span[@name='address_name']/following-sibling::div[hasclass('o_address_format')][1]" position="attributes">
                    <attribute name="colspan">2</attribute>
                </xpath>


                <!--
                    Email (and phone below): why this xpath is long
                    ................................................
                    We only set readonly on the main header email, not on every field[@name='email'] in
                    the merged arch. The partner form also embeds email on child contact forms and in
                    kanban templates; a short //field[@name='email'] often matches several nodes and
                    breaks the view, or readonly would apply in the wrong place.
                    So we narrow to the header row: a flex div that contains that field. Stock Odoo 19
                    uses classes d-flex, align-items-baseline, and w-md-50 on that row. 
                    
                        <div class="d-flex align-items-baseline w-md-50">
                            <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                            <field name="email" class="w-100" widget="email" required="user_ids" placeholder="Email"/>
                        </div>
                
                    The mail app, if installed, replaces that block so the field moves under o_row_readonly 
                    instead: same field, different wrapper. 
                    Only one of those layouts exists after merge. A single short xpath
                    would then match nothing when mail is installed, or nothing without mail. The
                    union (|) joins two locators; exactly one should match, so the module loads in both
                    cases and only the intended field gets readonly.
                -->


                <!-- Email / phone: narrow xpath so readonly applies only to the main header row (Odoo 19
                     d-flex w-md-50 vs mail module o_row_readonly); avoids matching embedded contact emails. -->
                
                
                
                <xpath expr="//div[hasclass('d-flex', 'align-items-baseline', 'w-md-50')][.//field[@name='email']]//field[@name='email'] | //div[hasclass('o_row_readonly')][.//field[@name='email']]//field[@name='email']" position="attributes">
                    <attribute name="readonly">is_patient</attribute>
                </xpath>

                <xpath expr="//div[hasclass('d-flex','align-items-baseline','w-md-50')][.//field[@name='phone']]//field[@name='phone'] | //div[hasclass('o_row_readonly')][.//field[@name='phone']]//field[@name='phone']" position="attributes">
                    <attribute name="readonly">is_patient</attribute>
                </xpath>

                <xpath expr="//field[@name='company_type']" position="attributes">
                    <attribute name="invisible">is_patient or is_institution or is_contractor or is_requestor</attribute>
                </xpath>
                <xpath expr="//field[@name='parent_id'][@widget='res_partner_many2one']" position="attributes">
                    <attribute name="invisible">is_patient or is_institution or is_contractor or is_requestor</attribute>
                </xpath>

                <xpath expr="//div[@colspan='2'][hasclass('d-flex','gap-2')][.//field[@name='company_name']]" position="attributes">
                    <attribute name="invisible">is_patient or is_institution or is_contractor or is_requestor</attribute>
                </xpath>

                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="invisible">is_geriatrics</attribute>
                </xpath>
                <xpath expr="//field[@name='function']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='website'][@widget='url']" position="attributes">
                    <attribute name="readonly">is_geriatrics and not is_institution</attribute>
                </xpath>

                <xpath expr="//span[@name='address_name']/following-sibling::div[hasclass('o_address_format')]/field[@name='street2']" position="attributes">
                    <attribute name="invisible">is_geriatrics</attribute>
                </xpath>

                <xpath expr="//span[@name='address_name']/following-sibling::div[hasclass('o_address_format')]/field[@name='state_id']" position="attributes">
                    <attribute name="invisible">is_geriatrics</attribute>
                </xpath>

                <xpath expr="//div[@name='div_address']/field[@name='street2']" position="attributes">
                    <attribute name="invisible">is_geriatrics</attribute>
                </xpath>

                <xpath expr="//div[@name='div_address']/field[@name='state_id']" position="attributes">
                    <attribute name="invisible">is_geriatrics</attribute>
                </xpath>

                <xpath expr="//field[@name='category_id']" position="attributes">
                    <attribute name="invisible">is_geriatrics</attribute>
                </xpath>

                <xpath expr="//group" position="after">
                <group string="Ugovori" invisible="not is_geriatrics">
                    <field name="contract_as_patient_ids" invisible="not is_patient" readonly="1">
                        <list>
                            <field name="contract_ref"/>
                            <field name="requested_by"/>
                            <field name="contractor"/>
                            <field name="status"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </list>
                    </field>
                    <field name="contract_as_signatory_ids" invisible="not is_contractor and not is_requestor" readonly="1" string="Ugovori (podnosilac / potpisnik)">
                        <list>
                            <field name="contract_ref"/>
                            <field name="patient"/>
                            <field name="requested_by"/>
                            <field name="contractor"/>
                            <field name="status"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </list>
                    </field>
                </group>
                </xpath>

                <xpath expr="//page[@name='sales_purchases']" position="attributes">
                    <attribute name="invisible">is_patient or is_institution</attribute>
                </xpath>
                <xpath expr="//page[@name='contact_addresses']" position="attributes" >
                    <attribute name="invisible">is_patient or is_institution</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
