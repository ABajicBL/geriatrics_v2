            </field>
        </record>

        <record id="medical_hospitalization_subunit_view_form" model="ir.ui.view">
            <field name="name">medical.hospitalization.subunit.form</field>
            <field name="model">medical.hospitalization.subunit</field>
            <field name="arch" type="xml">
                <form string="Odjel / soba">
                    <sheet>
                        <group>
                            <field name="subunit"/>
