                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="medical_hospitalization_admission_reason_view_form" model="ir.ui.view">
            <field name="name">medical.hospitalization.admission.reason.form</field>
            <field name="model">medical.hospitalization.admission.reason</field>
            <field name="arch" type="xml">
                <form string="Razlog prijema">
                    <sheet>
                        <group>
                            <field name="reason"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="medical_hospitalization_discharge_reason_view_form" model="ir.ui.view">
            <field name="name">medical.hospitalization.discharge.reason.form</field>
            <field name="model">medical.hospitalization.discharge.reason</field>
            <field name="arch" type="xml">
                <form string="Razlog otpusta">
