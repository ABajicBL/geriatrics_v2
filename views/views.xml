<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--- PATIENTS  -->
        <record id="medical_patient_view" model="ir.ui.view">
            <field name="name">Patient.form</field>
            <field name="model">medical.patient</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Patient" js_class="geriatrics_patient_form">
                    <sheet class="o_geriatrics_patient_sheet">
                        <div class="o_geriatrics_patient_header">
                            <field name="photo" nolabel="1" widget="image" class="oe_avatar oe_avatar_left" string="Photo"/>
                            <div class="oe_title">
                                <h1>
                                    <field name="partner_id" string="Ime" placeholder="Patient Name"/>
                                </h1>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="patient_id" string="ID"/>
                                <field name="jmbg"/>
                                <field name="dob"/>
                                <field name="id_document"/>
                                <field name="id_document_expiration"/>

                            </group>
                            <group>
                                <field name="deceased"/>
                                <field name="dod" invisible="not deceased"/>
                                <field name="sex"/>
                                <field name="age" readonly="1" class="o_geriatrics_age"/>
                                <field name="martial_status"/>
                                <field name="city" />
                                <field name="street" />
                                <field name="zip" />                                
                                <!--

                                -->
                            </group>
                        </group>

                        <group class="o_geriatrics_patient_family_group">
                            <field name="maiden_name" readonly="sex == 'm'"/>
                            <field name = "father_name"/>
                            <field name = "mother_name" />
                            <field name = "mother_surname" />
                            <field name = "husband_name" />    
                        </group>

                        <notebook>
                            <page string="Praćenje" name="tracking_list">
                                <field name="recent_tracking_list_ids" nolabel="1" readonly="1">
                                    <list create="0" edit="0" delete="0">
                                        <field name="date"/>
                                        <field name="info"/>
                                        <field name="create_uid" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Zdr. osiguranje" name="insurances">
                                <button name="action_create_insurance" type="object" string="Novo osiguranje" class="btn-secondary mb-2" invisible="not id"/>
                                <field name="insurance_ids" nolabel="1" readonly="1" colspan="2">
                                    <list>
                                        <field name="insurance_number"/>
                                        <field name="insurance_type_id"/>
                                        <field name="insurance_provider"/>
                                        <field name="insurance_category" optional="show"/>
                                        <field name="member_since"/>
                                        <field name="member_exp"/>
                                        <field name="notes" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <!--
            Readonly form when opening existing patients (list row or form-first), while keeping "Create" in edit mode.

            Problem
            For writable users the web client opens mono-record forms in edit mode by default. Attributes such as
            form edit="0" would lock the whole view and break new-record creation. Older approaches relied on
            ir.actions.act_window flags (e.g. initial_mode) reaching the browser; in Odoo 19, action_service does not
            map those onto FormController props.readonly, so backend-only patches are not enough for list to form.

            Solution (cross-referenced)
            .............................
            - views/menu.xml: action context {'open_form_readonly': True} — merged into props.context on list/form;
              JS patches read this (see long comment in menu.xml).
            - models/ir_actions.py: _get_readable_fields / _get_action_dict add optional flags on the action dict.
            - static/src/js/geriatrics_act_window_readonly.js: FormController.modelParams sets relational model
              mode readonly when context flag and resId are set (not props.readonly, so edition still works).
            - Form js_class geriatrics_patient_form: explicit Edit bar (static/src/xml + geriatrics_patient_form_controller.js).
        -->

        <record id="medical_patient_list_view" model="ir.ui.view">
            <field name="name">Patient.list</field>
            <field name="model">medical.patient</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="partner_id" string="Ime"/>
                    <field name="sex" string="Pol"/>
                    <field name="patient_id" string="ID"/>
                </list>
            </field>
        </record>

        <!--- CONTRACTS  -->
        <record id="medical_patient_contract_view_list" model="ir.ui.view">
            <field name="name">medical.patient.contract.list</field>
            <field name="model">medical.patient.contract</field>
            <field name="arch" type="xml">
                <list>
                    <field name="contract_ref"/>
                    <field name="patient"/>
                    <field name="contract_type" optional="show"/>
                    <field name="requested_by" optional="show"/>
                    <field name="contractor" optional="show"/>
                    <field name="status"/>

                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="create_date" optional="show"/>
                </list>
            </field>
        </record>

        <record id="medical_patient_contract_view_form" model="ir.ui.view">
            <field name="name">medical.patient.contract.form</field>
            <field name="model">medical.patient.contract</field>
            <field name="arch" type="xml">
                <form string="Ugovor">
                    <header>
                        <button name="action_activate_contract" type="object" string="Aktivacija" class="btn-primary" invisible="status != 'draft'"/>
                        <button name="action_terminate_contract" type="object" string="Raskid" invisible="status != 'open'"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,open,closed"/>
                    </header>
                    <sheet>
                        <!-- requested_by / contractor: quick-create defaults clear pacijent & institucija flags;
                             signatory booleans on res.partner still come only from saved contract links. -->
                        <group>
                            <group>
                                <field name="contract_ref"/>
                                <field name="contract_type"/>
                                <field name="patient"/>
                                <field name="requested_by" context="{'default_is_patient': False, 'default_is_institution': False}"/>
                                <field name="contractor" context="{'default_is_patient': False, 'default_is_institution': False}"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="create_uid" readonly="1"/>
                                <field name="create_date" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" placeholder="Napomene..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--- INSURANCE (per patient; also menu for full list)  -->
        <record id="medical_insurance_view_list" model="ir.ui.view">
            <field name="name">medical.insurance.list</field>
            <field name="model">medical.insurance</field>
            <field name="arch" type="xml">
                <list>
                    <field name="insurance_number"/>
                    <field name="patient"/>
                    <field name="insurance_type_id" optional="show"/>
                    <field name="insurance_provider" optional="show"/>
                    <field name="member_since"/>
                    <field name="member_exp"/>
                    <field name="create_date" optional="show"/>
                </list>
            </field>
        </record>

        <record id="medical_insurance_view_form" model="ir.ui.view">
            <field name="name">medical.insurance.form</field>
            <field name="model">medical.insurance</field>
            <field name="arch" type="xml">
                <form string="Zdravstveno osiguranje">
                    <sheet>
                        <group>
                            <group>
                                <field name="patient" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="insurance_number"/>
                                <field name="insurance_type_id"/>
                                <field name="insurance_provider"/>
                                <field name="insurance_category"/>
                            </group>
                            <group>
                                <field name="member_since"/>
                                <field name="member_exp"/>
                                <field name="create_uid" readonly="1"/>
                                <field name="create_date" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" placeholder="Napomene..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--- INSURANCE TYPE (lookup): no menu; form used when Many2one opens Create & edit. -->
        <record id="medical_insurance_type_view_form" model="ir.ui.view">
            <field name="name">medical.insurance.type.form</field>
            <field name="model">medical.insurance.type</field>
            <field name="arch" type="xml">
                <form string="Vrsta osiguranja">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--- HOSPITALIZATION + lookup tables  -->
        <record id="medical_hospitalization_view_list" model="ir.ui.view">
            <field name="name">medical.hospitalization.list</field>
            <field name="model">medical.hospitalization</field>
            <field name="arch" type="xml">
                <list>
                    <field name="hospitalization_code"/>
                    <field name="hospitalized_patient"/>
                    <field name="medical_hospital_unit_id"/>
                    <field name="medical_hospital_subunit_id" optional="show"/>
                    <field name="hospitalization_date"/>
                    <field name="state" widget="badge" optional="show"/>
                    <field name="discharge_date" />
                    <field name="hospitalization_reason" optional="hide"/>
                    <field name="info" optional="hide"/>
                    <field name="discharge_reason"/>
                    <field name="create_date" optional="show"/>
                </list>
            </field>
        </record>

        <record id="medical_hospitalization_view_form" model="ir.ui.view">
            <field name="name">medical.hospitalization.form</field>
            <field name="model">medical.hospitalization</field>
            <field name="arch" type="xml">
                <form string="Hospitalizacija">
                    <header>
                        <button name="action_hospitalize_patient" type="object" string="Hospitalizuj pacijenta" class="btn-primary" invisible="state != 'free'"/>
                        <button name="action_discharge_patient" type="object" string="Otpusti pacijenta" invisible="state != 'hospitalized'"/>
                        <field name="state" widget="statusbar" statusbar_visible="free,hospitalized"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="hospitalization_code"/>
                                <field name="hospitalized_patient" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="medical_hospital_unit_id"/>
                                <field name="medical_hospital_subunit_id"/>
                            </group>
                            <group>
                                <field name="hospitalization_date"/>
                                <field name="hospitalization_reason"/>
                                <field name="info" placeholder="Dodatne informacije..."/>
                                <field name="create_uid" readonly="1"/>
                                <field name="create_date" readonly="1"/>
                            </group>
                        </group>
                        <group string="Otpust">
                            <field name="discharge_date" readonly="state == 'free'"/>
                            <field name="discharge_reason" readonly="state == 'free'"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Lookup models: no menu; form for Many2one Create & edit; list is Odoo default for search. -->
