<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Left / persistent sidebar (Odoo 19 Community)
        ...............................................
        ir.ui.menu only declares entries; it cannot turn on a fixed desktop left rail. The CE 19
        backend shell uses web.NavBar: apps as a top dropdown, current-app sections as horizontal
        dropdowns (addons/web/static/src/webclient/navbar/navbar.xml + navbar.js). Small screens use
        a slide-over burger panel (o_app_menu_sidebar), toggled by state — not always open.

        To implement a true always-visible left menu you need a custom web layer, for example:
        - Register assets on web.assets_backend (SCSS + JS/XML patches).
        - Patch or replace NavBar / ActionContainer layout so section links render in a vertical
          column, or portal the menu into a fixed aside; adjust z-index, width, and overflow.
        - Expect to revisit selectors and OWL structure after Odoo upgrades.

        Until then, keep menu items flat under the app root (see comment on Contracts below) so they
        appear in the standard top navigation without an extra collapsible folder.
    -->
    <menuitem id="menu_geriatrics" name="Geriatrics" />

    <record id="action_geriatrics_patient" model="ir.actions.act_window">
        <field name="name">Geriatrics Patient</field>
        <field name="res_model">medical.patient</field>
        <field name="view_mode">list,form</field>
        <!--
            The action context is extended here so the client can open existing patients in a
            readonly (view-first) form while new records stay editable.

            open_form_readonly (action context)

            Whatever you put in ir.actions.act_window "context" is evaluated and merged into the
            browsing context for that action. The Odoo web client passes that merged dict down to
            ListController and FormController as props.context (together with user/session context).

            geriatrics_act_window_readonly.js patches FormController.modelParams. It does not hardcode
            action XML-IDs: it checks props.context.open_form_readonly and, when resId is set (existing
            record), sets the relational model config.mode to "readonly". New records have no resId, so
            Create stays editable. We do not rely on list switchView passing props.readonly: in Odoo 19
            that keeps fields readonly even after switching to edition; view-first mode must use model
            mode only (see comments in that JS file).

            models/ir_actions.py whitelists "flags" for /web/action/load and, for this action only,
            sets result["flags"] = {"initial_mode": "view"}. The JS patch above does not read flags; it
            uses this context key. The explicit Edit bar is geriatrics_patient_form_controller.js and
            geriatrics_patient_form.xml (js_class on the patient form in views.xml).
        -->
        <field name="context">{'open_form_readonly': True}</field>
    </record>

    <menuitem id="menu_geriatrics_patient" name="Patients" parent="menu_geriatrics" action="action_geriatrics_patient" sequence="10"/>

    <!--
        CONTRACT menu
        It is not possible to put as side menu under Administration group
        For example "Administration" with no action: Odoo v19 shows those as collapsible groups, 
        so entries stay hidden until expanded. 
        Better leave window actions directly under the app menu (top line from left to right)
    -->
    <record id="action_geriatrics_contracts" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">medical.patient.contract</field>
        <field name="view_mode">list,form</field>

    </record>

    <menuitem id="menu_geriatrics_contracts" name="Contracts" parent="menu_geriatrics" action="action_geriatrics_contracts" sequence="20"/>

    <record id="action_medical_insurance" model="ir.actions.act_window">
        <field name="name">Insurance</field>
        <field name="res_model">medical.insurance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_medical_insurance" name="Insurance" parent="menu_geriatrics" action="action_medical_insurance" sequence="22"/>

    <record id="action_medical_hospitalization" model="ir.actions.act_window">
        <field name="name">Hospitalization</field>
        <field name="res_model">medical.hospitalization</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_medical_hospitalization" name="Hospitalization" parent="menu_geriatrics" action="action_medical_hospitalization" sequence="23"/>

    <record id="action_medical_patient_tracking_list" model="ir.actions.act_window">
        <field name="name">Tracking List</field>
        <field name="res_model">medical.patient.tracking.list</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_medical_patient_tracking_list" name="Tracking List" parent="menu_geriatrics" action="action_medical_patient_tracking_list" sequence="24"/>

</odoo>